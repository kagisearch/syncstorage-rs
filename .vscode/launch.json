    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch rs-syncserver",
            "args": [
                "--config",
                "config/local.toml"
            ],
            "console": "integratedTerminal",
            "env": {
                "RUST_BACKTRACE": "full",
                "RUST_LOG": "debug"
            },
            "initCommands": [
                "command script import \"${env:HOME}/.rustup/toolchains/stable-aarch64-apple-darwin/lib/rustlib/etc/lldb_lookup.py\"",
                "command source -s 0 \"${env:HOME}/.rustup/toolchains/stable-aarch64-apple-darwin/lib/rustlib/etc/lldb_commands\""
            ],
            "program": "${workspaceFolder}/target/debug/syncserver",
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach",
            "pid": "${command:pickMyProcess}" // use ${command:pickProcess} to pick other users' processes
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach to rs-syncserver",
            "program": "${workspaceFolder}/target/debug/syncserver",
        },
        {
            "type": "lldb",
            "request": "attach",
            "name": "Attach to PID syncserver",
            "pid": "${input:syncserverPID}"
        },
        {
            "name": "Debug unit tests in library 'syncserver_common'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=syncserver-common"
                ]
            }
        },
        {
            "name": "Debug unit tests in library 'syncserver_db_common'",
            "type": "lldb",
            "request": "launch",
