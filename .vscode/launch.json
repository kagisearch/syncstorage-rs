    "inputs": [
        {
            "id": "syncserverPID",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "ps -A | grep '[s]yncserver' | awk '{print $1}'",
                "description": "Select syncserver PID",
                "useFirstResult": true,
            }
        }
